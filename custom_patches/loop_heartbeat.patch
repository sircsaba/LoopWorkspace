diff --git a/Loop/Managers/LoopAppManager.swift b/Loop/Managers/LoopAppManager.swift
index 04d561a..28c8271 100644
--- a/Loop/Managers/LoopAppManager.swift
+++ b/Loop/Managers/LoopAppManager.swift
@@ -358,6 +358,50 @@ class LoopAppManager: NSObject {
         deviceDataManager?.servicesManager.handleRemoteNotification(notification)
         return true
     }
+
+    // MARK: - Heartbeat push (custom)
+
+    /// Key present in the payload of a heartbeat push sent by the user's own server.
+    static let heartbeatUserInfoKey = "loop-heartbeat"
+
+    /// Called when a heartbeat push arrives. Fetches new CGM data (which triggers a loop if one is due)
+    /// and keeps the app alive briefly so the loop can finish talking to the pump.
+    func handleHeartbeatNotification(_ completion: @escaping () -> Void) {
+        removeDeliveredHeartbeatNotifications()
+
+        guard let deviceDataManager = deviceDataManager else {
+            completion()
+            return
+        }
+
+        var backgroundTask = UIBackgroundTaskIdentifier.invalid
+        let endBackgroundTask = {
+            if backgroundTask != .invalid {
+                UIApplication.shared.endBackgroundTask(backgroundTask)
+                backgroundTask = .invalid
+            }
+        }
+        backgroundTask = UIApplication.shared.beginBackgroundTask(withName: "Loop Heartbeat", expirationHandler: endBackgroundTask)
+        // Give the loop up to 25 s to complete pump communication, then release the background time.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 25, execute: endBackgroundTask)
+
+        deviceDataManager.remoteHeartbeatDidFire {
+            DispatchQueue.main.async(execute: completion)
+        }
+    }
+
+    /// Heartbeats sent in "passive" mode are visible notifications; clear them so they don't pile up.
+    private func removeDeliveredHeartbeatNotifications() {
+        let center = UNUserNotificationCenter.current()
+        center.getDeliveredNotifications { notifications in
+            let ids = notifications
+                .filter { $0.request.content.userInfo[LoopAppManager.heartbeatUserInfoKey] != nil }
+                .map { $0.request.identifier }
+            if !ids.isEmpty {
+                center.removeDeliveredNotifications(withIdentifiers: ids)
+            }
+        }
+    }
     
