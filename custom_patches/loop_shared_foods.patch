+                        }
+                        .onDelete { picks.remove(atOffsets: $0) }
+                        let absorption = SharedFoodStore.absorptionTime(for: picks, defaults: defaults)
+                        Text(String(format: NSLocalizedString("Absorption time %.1f h (%@)", comment: "Shared food list: absorption time shown"), absorption.0 / 3600, absorption.1))
+                            .font(.caption).foregroundColor(.secondary)
+                    }
+                }
+                Section(header: filterBar) {
+                    if filter == "school" && search.isEmpty {
+                        if store.lunch.isEmpty {
+                            Text("Nothing left in today's school lunch.", comment: "Shared food list: no school lunch").foregroundColor(.secondary)
+                        }
+                        ForEach(store.lunch) { item in
+                            let picked = picks.contains { $0.lunchKey == item.key }
+                            Button(action: { toggleLunch(item) }) {
+                                foodRow(item.food, detail: "\(item.food.amountText(item.left)) · \(String(format: "%.0f", item.food.carbs(for: item.left))) g", picked: picked)
+                            }
+                        }
+                    } else {
+                        if shown.isEmpty {
+                            Text(store.foods.isEmpty && store.loading ? NSLocalizedString("Loading…", comment: "Shared food list: loading") : NSLocalizedString("No food here. Try All, or search.", comment: "Shared food list: empty"))
+                                .foregroundColor(.secondary)
+                        }
+                        ForEach(shown) { f in
+                            Button(action: { add(f) }) {
+                                foodRow(f, detail: "\(String(format: "%.0f", f.carbs)) g carbs / \(f.amountText(f.portion))", picked: picks.contains { $0.food.id == f.id && $0.lunchKey == nil })
+                            }
+                        }
+                    }
+                }
+            }
+            .listStyle(.insetGrouped)
+            .searchable(text: $search, prompt: Text("Search the foods", comment: "Shared food list: search"))
+            .refreshable { await store.load() }
+            .navigationBarTitle(Text("Foods", comment: "Shared food list title"), displayMode: .inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarLeading) {
+                    Button(action: { dismiss() }) { Text("Cancel", comment: "Button label for cancel") }
+                }
+                ToolbarItem(placement: .navigationBarTrailing) {
+                    Button(action: {
+                        onUse(picks)
+                        dismiss()
+                    }) {
+                        Text(String(format: NSLocalizedString("Use %.0f g", comment: "Shared food list: use the picked foods"), totalCarbs)).fontWeight(.semibold)
+                    }
+                    .disabled(picks.isEmpty)
+                }
+            }
+            .task {
+                if store.foods.isEmpty || !store.loading { await store.load() }
+                if store.foods.allSatisfy({ !$0.favorite }) && filter == "favorites" { filter = store.lunch.isEmpty ? "all" : "school" }
+            }
+        }
+    }
+
+    private var filterBar: some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            HStack(spacing: 6) {
+                ForEach(0..<SharedFoodPickerView.filters.count, id: \.self) { i in
+                    let f = SharedFoodPickerView.filters[i]
+                    chip(f.1, on: filter == f.0, icon: f.0 == "favorites" ? "star.fill" : (f.0 == "school" ? "takeoutbag.and.cup.and.straw" : nil)) { filter = f.0 }
+                }
+                chip(NSLocalizedString("Gluten-free only", comment: "Food filter"), on: glutenFreeOnly, icon: nil) { glutenFreeOnly.toggle() }
+            }
+            .padding(.vertical, 4)
+        }
+        .textCase(nil)
+    }
+
+    private func chip(_ title: String, on: Bool, icon: String?, action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            HStack(spacing: 4) {
+                if let icon { Image(systemName: icon).font(.caption) }
+                Text(title).font(.subheadline)
+            }
+            .padding(.horizontal, 12)
+            .padding(.vertical, 6)
+            .foregroundColor(on ? .white : .primary)
+            .background(Capsule().fill(on ? Color.accentColor : Color(.secondarySystemFill)))
+        }
+        .buttonStyle(.plain)
+    }
+
+    private func foodRow(_ f: SharedFood, detail: String, picked: Bool) -> some View {
+        HStack(spacing: 10) {
+            Image(systemName: picked ? "checkmark.circle.fill" : (f.favorite ? "star.fill" : "circle"))
+                .foregroundColor(picked ? .accentColor : (f.favorite ? .orange : .secondary))
+            VStack(alignment: .leading, spacing: 2) {
+                Text(f.name).foregroundColor(.primary).lineLimit(2)
+                Text([f.brand, detail].filter { !$0.isEmpty }.joined(separator: " · ")).font(.caption).foregroundColor(.secondary)
+            }
+            Spacer()
+            if f.gluten == "free" {
+                Text("GF").font(.caption2.bold()).foregroundColor(.green)
+                    .padding(.horizontal, 5).padding(.vertical, 2)
+                    .overlay(RoundedRectangle(cornerRadius: 5).stroke(Color.green))
+            } else if f.gluten == "contains" {
+                Text("Gluten").font(.caption2.bold()).foregroundColor(.red)
+                    .padding(.horizontal, 5).padding(.vertical, 2)
+                    .overlay(RoundedRectangle(cornerRadius: 5).stroke(Color.red))
+            }
+        }
+    }
+
+    private func pickRow(_ k: Binding<SharedFoodPick>) -> some View {
+        let p = k.wrappedValue
+        let step = p.lunchLeft.map { $0 / 4 } ?? p.food.portion / 2
+        let maximum = p.lunchLeft ?? p.food.portion * 20
+        return VStack(alignment: .leading, spacing: 4) {
+            HStack {
+                Text(p.food.name).lineLimit(1)
+                Spacer()
+                Text(String(format: "%.0f g", p.carbs)).foregroundColor(.secondary)
+            }
+            Stepper(value: k.amount, in: step...maximum, step: step) {
+                Text(p.food.amountText((p.amount * 100).rounded() / 100)).font(.caption)
+            }
+        }
+    }
+
+    private func add(_ f: SharedFood) {
+        if let i = picks.firstIndex(where: { $0.food.id == f.id && $0.lunchKey == nil }) {
+            picks[i].amount += f.portion
+        } else {
+            picks.append(SharedFoodPick(food: f, amount: f.portion))
+        }
+    }
+
+    private func toggleLunch(_ item: SharedLunchItem) {
+        if let i = picks.firstIndex(where: { $0.lunchKey == item.key }) {
+            picks.remove(at: i)
+        } else {
+            picks.append(SharedFoodPick(food: item.food, amount: item.left, lunchKey: item.key, lunchLeft: item.left))
+        }
+    }
+}
