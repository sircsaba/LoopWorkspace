+struct SharedFoodPickerView: View {
+    @Environment(\.dismiss) private var dismiss
+    @ObservedObject private var store = SharedFoodStore.shared
+    let defaults: CarbStore.DefaultAbsorptionTimes
+    let onUse: @MainActor ([SharedFoodPick]) -> Void
+
+    @State private var picks: [SharedFoodPick]
+    @State private var search = ""
+    @State private var filter = "favorites"
+    @State private var glutenFreeOnly = false
+
+    init(initial: [SharedFoodPick], defaults: CarbStore.DefaultAbsorptionTimes, onUse: @escaping @MainActor ([SharedFoodPick]) -> Void) {
+        _picks = State(initialValue: initial)
+        self.defaults = defaults
+        self.onUse = onUse
+    }
+
+    private static let filters: [(String, String)] = [
+        ("favorites", NSLocalizedString("Favorites", comment: "Food filter")),
+        ("all", NSLocalizedString("All", comment: "Food filter")),
+        ("breakfast", NSLocalizedString("Breakfast", comment: "Food filter")),
+        ("lunch", NSLocalizedString("Lunch", comment: "Food filter")),
+        ("supper", NSLocalizedString("Supper", comment: "Food filter")),
+        ("snack", NSLocalizedString("Snack", comment: "Food filter")),
+        ("school", NSLocalizedString("School lunch", comment: "Food filter")),
