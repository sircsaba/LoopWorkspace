+// MARK: - Backup server (custom): a second Nightscout-compatible site, e.g. bg.example.com
+
+extension KeychainManager {
+    private enum BackupConfig {
+        static let label = "NightscoutCGMBackup"
+    }
+
+    func setNightscoutCgmBackupCredentials(_ url: URL?, apiSecret: String?) {
+        do {
+            let credentials: InternetCredentials?
+            if let url = url, let apiSecret = apiSecret, !apiSecret.isEmpty {
+                credentials = InternetCredentials(username: BackupConfig.label, password: apiSecret, url: url)
+            } else {
+                credentials = nil
+            }
+            try replaceInternetCredentials(credentials, forAccount: BackupConfig.label)
+        } catch {}
+    }
+
+    func getNightscoutCgmBackupURL() -> URL? {
+        return try? getInternetCredentials(account: BackupConfig.label).url
+    }
+
+    func getNightscoutCgmBackupAPISecret() -> String? {
+        return try? getInternetCredentials(account: BackupConfig.label).password
+    }
+}
